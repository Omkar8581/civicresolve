rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.admin == true || 
         request.auth.token.email.matches('.*@civicresolve\\.gov.*') ||
         request.auth.token.role == 'admin');
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Complaints collection rules
    match /complaints/{complaintId} {
      // Anyone authenticated can read complaints they created; admins can read all
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      
      // Citizens can create new complaints with their own userId
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Admins can update status, department, and remarks
      allow update: if isAdmin();
      
      // Only super-admins can delete
      allow delete: if isAdmin();
    }
    
    // User Profiles
    match /users/{userId} {
      // User can read their own profile; admins can read all
      allow read: if isOwner(userId) || isAdmin();

      // Newly authenticated citizen can safely create their own users/{uid} document
      // Strictly enforced role: "citizen", preventing unauthorized admin/officer role creation
      allow create: if isOwner(userId) && 
                      request.resource.data.uid == userId &&
                      request.resource.data.role == 'citizen';

      // Citizens cannot elevate their role to admin or officer, nor modify another user's profile
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();

      // Only administrators can remove profiles
      allow delete: if isAdmin();
    }
    
    // Department Activity Logs
    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
    }
  }
}
