# Server & Service URLs
PORT=5001
AI_SERVICE_URL=http://localhost:8000

# ==========================================
# CITIZEN NOTIFICATION SYSTEM CONFIGURATION
# ==========================================

# Test Mode: Set to 'true' to safely simulate and log Email/SMS dispatches to console without incurring costs.
# Set to 'false' in production when live SMTP and SMS credentials are provided.
NOTIFICATION_TEST_MODE=true

# --- 1. Email Notification Settings (SMTP) ---
EMAIL_FROM=CivicResolve Notifications <notifications@civicresolve.gov>
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.your_sendgrid_key

# --- 2. SMS Notification Settings (Twilio or Provider Adapter) ---
SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_PHONE_NUMBER=+1234567890

# ==========================================
# OPTIONAL FIRESTORE / FIREBASE CREDENTIALS
# ==========================================
# FIREBASE_PROJECT_ID=civicresolve-prod
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@civicresolve.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
